# Copie este arquivo para .env e preencha. O .env nunca vai para o repositório.

# Estúdio de Vocal (pago, Replicate) — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Plano B das sugestões (YouTube Data API v3) — opcional
YOUTUBE_API_KEY=

# Importar playlist do Spotify — opcional (app em modo de desenvolvimento)
# Cadastre o redirect http://127.0.0.1:8888/callback no painel do app do Spotify.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Explicação das transições (Gemini, camada gratuita) — opcional
GEMINI_API_KEY=
# Músicas com restrição de idade: navegador com o YouTube logado (firefox recomendado).
# Ou coloque um cookies.txt na pasta do painel (tem prioridade).
YOUTUBE_COOKIES_BROWSER=
